# Copy to .env and fill in. .env is git-ignored; this file is not.
#
# RULE: a key that is read anywhere in the codebase MUST appear here, in the
# same commit that starts reading it. This file is the schema — the validator
# in src/config/env fails the process on startup if a required key is absent,
# so a missing entry here becomes a loud error, not a 3am null-pointer.

# ---- runtime -----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---- AI providers ------------------------------------------------------
# Only set the ones you actually use. The gateway resolves a provider from
# the model id, and only requires that provider's key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Cost guardrail. The gateway refuses a request it estimates would exceed
# this, so a runaway loop costs cents instead of a mortgage payment.
AI_MAX_USD_PER_RUN=1.00

# ---- observability -----------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
