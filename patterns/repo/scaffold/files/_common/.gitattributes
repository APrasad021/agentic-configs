# Normalise line endings so a Windows checkout does not produce a whole-file
# diff. * text=auto lets git decide per file.
* text=auto eol=lf

*.sh   text eol=lf
*.bat  text eol=crlf

# Binary — never diff, never merge, never normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.mp4  binary
*.mov  binary
*.webm binary
*.woff binary
*.woff2 binary

# Generated. Collapse in PR diffs so review attention goes to real changes.
package-lock.json  linguist-generated=true -diff
pnpm-lock.yaml     linguist-generated=true -diff
yarn.lock          linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
poetry.lock        linguist-generated=true -diff
